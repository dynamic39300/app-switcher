# Replace the owned hostname and certificate paths. This is not a live deployment.
# Keep the upstream loopback-only, set TRUSTED_PROXY_IPS=127.0.0.1 and TRUST_PROXY_HTTPS=1.
# Deliberately omit query strings, IP addresses and referrers from application access logs.
log_format appswitcher '$request_method $uri $status $request_time';
limit_req_zone $binary_remote_addr zone=commerce_api:10m rate=10r/s;
server {
    listen 80;
    server_name YOUR_OWNED_DOMAIN;
    return 308 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name YOUR_OWNED_DOMAIN;
    ssl_certificate /etc/letsencrypt/live/YOUR_OWNED_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_OWNED_DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log /var/log/nginx/appswitcher.access.log appswitcher;
    client_max_body_size 64k;
    location / {
        limit_req zone=commerce_api burst=30 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 50s;
    }
    # Download artifacts are a separate fixed directory, never a writable upload endpoint.
    location /releases/ {
        alias /var/lib/appswitcher/releases/;
        autoindex off;
        add_header X-Content-Type-Options nosniff;
        add_header Content-Disposition attachment;
        limit_except GET { deny all; }
    }
}
