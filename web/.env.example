# Example names only. Inject secrets via the deployment secret store; this file is not auto-loaded.
APPSWITCHER_ENV=development
PUBLIC_URL=http://127.0.0.1:8000
SIMULATED_PAYMENTS=0
WECHAT_ENABLED=0
ALIPAY_ENABLED=0
# Production additionally requires:
# APPSWITCHER_RUNTIME_DIR=/var/lib/appswitcher/runtime (writable, outside read-only code)
# DJANGO_SECRET_KEY (random 50+ characters)
# DATABASE_URL (postgresql connection from secret store)
# DATABASE_SSLMODE=verify-full
# PGSSLROOTCERT=/run/secrets/postgres-ca.pem
# LICENSE_PRIVATE_KEY_FILE=/run/secrets/license-ed25519.pem
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST, EMAIL_PORT=587, EMAIL_HOST_USER, EMAIL_HOST_PASSWORD
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=AppSwitcher <your verified sender>
# SUPPORT_EMAIL, LEGAL_ENTITY_NAME
# PUBLIC_URL=https://your-owned-domain
# TRUSTED_PROXY_IPS=127.0.0.1 (only exact reverse-proxy addresses; it must overwrite X-Real-IP)
# TRUST_PROXY_HTTPS=1 (only for a trusted, header-overwriting reverse proxy)
# WECHAT_APP_ID, WECHAT_MCH_ID, WECHAT_CERT_SERIAL
# WECHAT_PRIVATE_KEY_FILE, WECHAT_PUBLIC_KEY_ID, WECHAT_PUBLIC_KEY_FILE, WECHAT_API_V3_KEY
# ALIPAY_APP_ID, ALIPAY_SELLER_ID, ALIPAY_PRIVATE_KEY_FILE, ALIPAY_PUBLIC_KEY_FILE
